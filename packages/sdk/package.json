{
  "name": "@portalops/sdk",
  "version": "0.2.0",
  "description": "TypeScript client for the PortalOps REST API, plus webhook signature verification.",
  "keywords": [
    "portaldot",
    "blockchain",
    "webhooks",
    "events",
    "middleware",
    "sdk",
    "evm"
  ],
  "homepage": "https://github.com/nofazechris/portalops/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nofazechris/portalops.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/nofazechris/portalops/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
