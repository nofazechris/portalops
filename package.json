{
  "name": "portalops-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preflight": "node scripts/network-preflight/preflight.mjs",
    "verify:evidence": "node scripts/verify-evidence/verify.mjs",
    "contract:compile": "node scripts/deploy-demo-contract/compile.mjs",
    "contract:deploy": "node scripts/deploy-demo-contract/compile.mjs && node scripts/deploy-demo-contract/deploy.mjs",
    "contract:interact": "node scripts/deploy-demo-contract/interact.mjs",
    "pretest": "node scripts/check-node.mjs",
    "test": "node --test --no-warnings=ExperimentalWarning \"packages/**/*.test.ts\" \"apps/**/*.test.ts\" \"src/**/*.test.js\"",
    "typecheck": "tsc -p .",
    "test:pg": "node scripts/test-postgres.mjs",
    "examples:build": "node scripts/examples/build.mjs",
    "db:check": "node --no-warnings=ExperimentalWarning scripts/db-check.mjs",
    "mcp": "node --no-warnings=ExperimentalWarning packages/mcp/main.ts",
    "security:scan": "node scripts/security-scan.mjs",
    "security:install-hook": "node scripts/security-scan.mjs --install-hook",
    "pipeline:test": "node --no-warnings=ExperimentalWarning scripts/test-event-pipeline/run.ts",
    "worker": "node --no-warnings=ExperimentalWarning apps/worker/main.ts",
    "api": "node --no-warnings=ExperimentalWarning apps/api/main.ts",
    "sdk:build": "tsc -p packages/sdk/tsconfig.build.json",
    "mcp:build": "node packages/mcp/build.mjs",
    "db:backup": "node --no-warnings=ExperimentalWarning scripts/backup-db.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@polkadot/api": "^17.0.2",
    "@polkadot/api-contract": "^17.0.2",
    "@polkadot/rpc-provider": "^17.0.2",
    "@polkadot/types": "^17.0.2",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "solc": "^0.8.28",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "marked": "^18.1.1",
    "thinking-orbs": "^0.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
