# One line-ending convention everywhere: text files are checked out with LF on every platform (Windows included).
# Without this, a Windows checkout turns the Solidity sources into CRLF and the committed contract artifacts (built from the LF sources)
# stop matching them, which is exactly the kind of "artifacts out of sync with the source" a reviewer would hit.
* text=auto eol=lf

# Binary files are never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.wasm binary
*.sqlite binary
